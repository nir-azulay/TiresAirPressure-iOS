opt_out_usage

default_platform(:ios)

XCODEPROJ  = "TirePressureManager.xcodeproj".freeze
SCHEME     = "TirePressureManager".freeze
BUNDLE_ID  = "com.nazulay.tirepressuremanager".freeze
INFO_PLIST = "App/Info.plist".freeze
OUTPUT_DIR = "build".freeze
IPA_NAME   = "TirePressureManager.ipa".freeze
KEYCHAIN   = "fastlane_tmp_keychain".freeze

platform :ios do
  desc "Build the Release configuration and upload it to TestFlight"
  lane :beta do
    key_path = ENV["ASC_KEY_PATH"]
    key_content = ENV["ASC_KEY_P8_BASE64"]

    api_key = if key_path && File.exist?(key_path)
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: key_path
      )
    else
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: key_content,
        is_key_content_base64: true
      )
    end

    if is_ci
      # Builds into a throwaway keychain so the runner never keeps signing material.
      setup_ci(keychain_name: KEYCHAIN)

      import_certificate(
        certificate_path: ENV.fetch("IOS_DIST_CERT_P12_PATH"),
        certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
        keychain_name: KEYCHAIN,
        keychain_password: ""
      )
    end

    # Fetch/download the App Store provisioning profile using App Store Connect API
    profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: BUNDLE_ID
    )

    profile_name = ENV["SIGH_NAME"] || profile || "#{BUNDLE_ID} AppStore"

    # The target sets GENERATE_INFOPLIST_FILE = NO, so CFBundleVersion is taken
    # verbatim from Info.plist rather than from CURRENT_PROJECT_VERSION.
    build_number = ENV.fetch("BUILD_NUMBER")
    set_info_plist_value(path: INFO_PLIST, key: "CFBundleVersion", value: build_number)
    UI.message("Building #{get_info_plist_value(path: INFO_PLIST, key: 'CFBundleShortVersionString')} (#{build_number})")

    # Automatic signing asks Apple to create a development certificate. The account
    # is already at the certificate limit, and CI already imported the distribution
    # certificate plus the App Store profile.
    if is_ci
      update_code_signing_settings(
        use_automatic_signing: false,
        path: XCODEPROJ,
        team_id: "6VD7L6T443",
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        targets: ["TirePressureManager"],
        build_configurations: ["Release"]
      )
    end

    export_options = {
      provisioningProfiles: {
        BUNDLE_ID => profile_name
      },
      manageAppVersionAndBuildNumber: false
    }
    export_options[:signingStyle] = "manual" if is_ci

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: IPA_NAME,
      clean: true,
      codesigning_identity: ("Apple Distribution" if is_ci),
      export_options: export_options
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(OUTPUT_DIR, IPA_NAME),
      distribute_external: false,
      skip_waiting_for_build_processing: true
    )
  end
end
